/* Unity.Hare — UI foundation theme (U.HARE-T45). Every screen (HUD, menus, results, upgrade, story) is built in
   code with Scripts/UI/HareUi.cs against these classes; nothing is wired up by hand in the Editor. Colours and
   sizes here are a placeholder pass (dark cockpit navy, cyan accent) until the screens built on the original's art
   (U.HARE-T46) restyle them. Text is the original's (U.HARE-T48): every face is a bitmap FontAsset baked from
   GameMaker's own glyph atlas (Resources/Hare/Fonts), drawn 1:1 at a font-size equal to its font.gmx size and never
   faux-bolded, and the named text styles at the end of this file (HareTextStyles) map each kind of text to the face
   the original drew it with.

   An ".outline-text" box (HareUi.OutlineText) is a stack of plain Labels at pixel offsets, not one element, so a
   rule meant for its text (size, weight, alignment) targets the box itself and relies on USS inheritance to reach
   every Label inside it — never ".outline-text > Label", which would also re-style the outline layers apart from
   the text layer and break the stack. */

.fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.row { flex-direction: row; align-items: center; }
.col { flex-direction: column; }
.center { align-items: center; justify-content: center; }
.hidden { display: none; }

/* fnt_point, the face the original draws most of its text with, is every screen's default. */
.hare-root {
    -unity-font-definition: resource("Hare/Fonts/fnt_point");
    font-size: 12px;
    color: rgb(235, 240, 255);
    -unity-font-style: normal;
}

/* HarePanel.BuildRoot's stage: always exactly 1920x1080 logical pixels, centred by HareUiFit inside whatever
   larger logical area the panel's match axis produces on a non-16:9 window — the UI's equivalent of
   LetterboxCamera's pillarbox/letterbox bars. Clipped so nothing a screen adds drifts out into the bars. */
.hare-stage {
    overflow: hidden;
}

/* ── Outline text (draw_text_outline family) ────────────────────────────────────────────────────────────── */
.outline-text {
    -unity-text-align: upper-left;
}

/* ── Windows / dialogs (obj_tip, obj_yesno_dialog) ──────────────────────────────────────────────────────── */
.hare-window {
    border-width: 3px;
    border-color: rgb(90, 200, 220);
    border-radius: 10px;
    background-color: rgba(8, 14, 28, 0.92);
    padding: 24px 28px;
}

/* A window or dialog heading: fnt_score, as obj_yesno_dialog and obj_level_results draw theirs. */
.hare-window-title {
    -unity-font-definition: resource("Hare/Fonts/fnt_score");
    font-size: 36px;
    margin-bottom: 14px;
}

.hare-veil {
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

.hare-dialog {
    min-width: 520px;
    align-items: center;
}

.hare-dialog-message {
    -unity-font-definition: resource("Hare/Fonts/fnt_point");
    font-size: 12px;
    margin: 6px 0 20px 0;
}

.hare-dialog-buttons {
    justify-content: center;
}

/* ── Buttons (obj_btn_*) ─────────────────────────────────────────────────────────────────────────────────── */
.hare-btn {
    min-height: 72px;
    min-width: 220px;
    padding: 0 28px;
    margin: 6px;
    border-width: 3px;
    border-radius: 10px;
    border-color: rgb(90, 200, 220);
    background-color: rgb(16, 28, 52);
    align-items: center;
    justify-content: center;
}
.hare-btn:hover { background-color: rgb(24, 44, 78); border-color: rgb(140, 230, 245); }
.hare-btn:active { background-color: rgb(10, 18, 34); }
.hare-btn--small { min-height: 56px; min-width: 140px; padding: 0 18px; }

/* A button's caption: fnt_score, as the title buttons (obj_btn_campaign, _quickstart, _quit, _yes, _no) draw theirs. */
.hare-btn-label {
    -unity-font-definition: resource("Hare/Fonts/fnt_score");
    font-size: 36px;
    -unity-text-align: middle-center;
}

/* ── Bars / gauges (health, energy, ammo) ───────────────────────────────────────────────────────────────── */
.hare-bar {
    height: 26px;
    border-width: 2px;
    border-radius: 6px;
    border-color: rgb(90, 200, 220);
    background-color: rgba(0, 0, 0, 0.5);
    overflow: hidden;
}
/* obj_energybar's own three-tier image_blend (HARE.gmx): c_lightgreen above two thirds (globals.gml defines it
   as rgb(168,157,4) — an odd, olive choice for a name that says "green", but the original's own value, ported
   exactly), c_yellow down to a third, c_red at or below that (HareUi.LowThreshold/MidThreshold). */
.hare-bar-fill {
    height: 100%;
    background-color: rgb(168, 157, 4);
}
.hare-bar-fill--mid {
    background-color: rgb(255, 255, 0);
}
.hare-bar-fill--low {
    background-color: rgb(255, 0, 0);
}

/* ── Named text styles (HareTextStyles, U.HARE-T48) ──────────────────────────────────────────────────────────
   Each kind of text in the face the original's draw_set_font picks for it (docs/REVERSE_ENGINEERING.md, Fonts),
   at the face's font.gmx size, which draws its baked atlas 1:1. Kept last so a style wins over a widget class's own
   face on the same element. */
.text-hud-score         { -unity-font-definition: resource("Hare/Fonts/fnt_score");  font-size: 36px; }
.text-hud               { -unity-font-definition: resource("Hare/Fonts/fnt_point");  font-size: 12px; }
.text-hud-ammo          { -unity-font-definition: resource("Hare/Fonts/fnt_small");  font-size: 11px; }
.text-menu-title        { -unity-font-definition: resource("Hare/Fonts/fnt_score");  font-size: 36px; }
.text-menu              { -unity-font-definition: resource("Hare/Fonts/fnt_point");  font-size: 12px; }
.text-typewriter        { -unity-font-definition: resource("Hare/Fonts/fnt_point");  font-size: 12px; }
.text-story             { -unity-font-definition: resource("Hare/Fonts/fnt_medium"); font-size: 16px; }
.text-conversation      { -unity-font-definition: resource("Hare/Fonts/fnt_score");  font-size: 36px; }
.text-conversation-name { -unity-font-definition: resource("Hare/Fonts/fnt_point");  font-size: 12px; }
.text-float             { -unity-font-definition: resource("Hare/Fonts/fnt_point");  font-size: 12px; }
.text-default           { -unity-font-definition: resource("Hare/Fonts/fnt_basic");  font-size: 12px; }
